<Project>
  <PropertyGroup>
    <!-- One version for every Serde.FS package (Serde.FS, Serde.FS.AspNet,
         Serde.FS.Fable). Client and server must agree on the wire format,
         so upgrade them together by changing this number. -->
    <SerdePackagesVersion>1.0.0</SerdePackagesVersion>
  </PropertyGroup>
</Project>
